rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A teacher role can only be assigned through trusted Firebase Admin SDK.
    function isTeacher() {
      return signedIn() && request.auth.token.role == 'teacher';
    }

    function isStudent(uid) {
      return signedIn()
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'student'
        && get(/databases/$(database)/documents/users/$(uid)).data.isApproved == true;
    }

    function consentPath(studentUid) {
      return /databases/$(database)/documents/consents/consent_$(studentUid)_$(request.auth.uid);
    }

    function hasConsent(studentUid, permission) {
      return isTeacher()
        && exists(consentPath(studentUid))
        && get(consentPath(studentUid)).data.studentUid == studentUid
        && get(consentPath(studentUid)).data.teacherUid == request.auth.uid
        && get(consentPath(studentUid)).data.isRevoked == false
        && get(consentPath(studentUid)).data[permission] == true;
    }

    function hasAnyConsent(studentUid) {
      return hasConsent(studentUid, 'shareAccommodations')
        || hasConsent(studentUid, 'shareCommunicationPrefs')
        || hasConsent(studentUid, 'shareEmergencyProtocol')
        || hasConsent(studentUid, 'shareClinicalDiagnosis');
    }

    // User accounts: students may register themselves, but cannot create teachers.
    // Teacher claims are provisioned only by a trusted backend/Admin SDK.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'id', 'fullName', 'email', 'studentId', 'role',
          'isApproved', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == uid
        && request.resource.data.role == 'student'
        && request.resource.data.isApproved == true
        && request.resource.data.email == request.auth.token.email;

      allow update: if isStudent(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'studentNumber', 'updatedAt'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.isApproved == resource.data.isApproved
        && request.resource.data.email == resource.data.email;

      allow delete: if false;
    }

    // Student root document contains only ordinary academic/profile information.
    match /students/{studentUid} {
      // Teachers must read only the exact shared/private document they were authorized for.
      allow get: if isOwner(studentUid);
      allow list: if false;
      allow create, update: if isStudent(studentUid);
      allow delete: if false;

      // Documents in this collection are independently permissioned.
      match /shared/{documentId} {
        allow get: if isOwner(studentUid)
          || (documentId == 'accommodations' && hasConsent(studentUid, 'shareAccommodations'))
          || (documentId == 'communication' && hasConsent(studentUid, 'shareCommunicationPrefs'));
        allow list: if false;
        allow create, update: if isStudent(studentUid)
          && documentId in ['accommodations', 'communication'];
        allow delete: if isStudent(studentUid);
      }

      // Highly sensitive documents: never available through collection queries.
      match /private/{documentId} {
        allow get: if isOwner(studentUid)
          || (documentId == 'clinical' && hasConsent(studentUid, 'shareClinicalDiagnosis'))
          || (documentId == 'emergency' && hasConsent(studentUid, 'shareEmergencyProtocol'));
        allow list: if false;
        allow create, update: if isStudent(studentUid)
          && documentId in ['clinical', 'emergency'];
        allow delete: if isStudent(studentUid);
      }
    }

    // One consent per student-teacher pair. No course-level expiry.
    match /consents/{consentId} {
      allow get: if signedIn()
        && (resource.data.studentUid == request.auth.uid
          || resource.data.teacherUid == request.auth.uid);
      allow list: if false;

      allow create: if isStudent(request.auth.uid)
        && consentId == 'consent_' + request.auth.uid + '_' + request.resource.data.teacherUid
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.teacherUid is string
        && request.resource.data.isRevoked == false
        && request.resource.data.keys().hasOnly([
          'studentUid', 'teacherUid',
          'shareAccommodations', 'shareCommunicationPrefs',
          'shareEmergencyProtocol', 'shareClinicalDiagnosis',
          'isRevoked', 'grantedAtMillis', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'studentUid', 'teacherUid',
          'shareAccommodations', 'shareCommunicationPrefs',
          'shareEmergencyProtocol', 'shareClinicalDiagnosis',
          'isRevoked', 'grantedAtMillis'
        ]);

      allow update: if isStudent(resource.data.studentUid)
        && resource.data.studentUid == request.auth.uid
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.teacherUid == resource.data.teacherUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'shareAccommodations', 'shareCommunicationPrefs',
          'shareEmergencyProtocol', 'shareClinicalDiagnosis',
          'isRevoked', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // Authoritative audit records must be written by trusted backend code only.
    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    // Legacy audit collection is also closed to prevent bypass through old paths.
    match /audit_logs/{logId} {
      allow read, write: if false;
    }

    // Deny every collection/document not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
